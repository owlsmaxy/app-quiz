# Server-only settings. Never expose service-role or provider secrets to the browser.
PORT=8000
APP_ORIGIN=http://localhost:8000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-only

# Supabase Edge Function secrets (set with `supabase secrets set`, not in frontend files)
GROQ_API_KEY=replace-me-server-only
GROQ_MODEL=llama-3.3-70b-versatile
AI_FREE_DAILY_LIMIT=20
AI_PREMIUM_DAILY_LIMIT=200
